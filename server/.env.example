PORT=5000
DB_HOST=your_hostinger_remote_mysql_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306
JWT_SECRET=change-this-in-production-use-a-long-random-string
CORS_ORIGINS=https://yourdomain.com,http://localhost:5173
NODE_ENV=production

# Login rate limiting (applied only to POST /api/auth/login)
# LOGIN_RATE_LIMIT_WINDOW_MS defaults to 900000 (15 minutes)
# LOGIN_RATE_LIMIT_MAX defaults to 5
# Rate limiting is automatically skipped when NODE_ENV=development
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5

# --- File Storage ---
# STORAGE_DRIVER: "local" (default) or "s3" (S3-compatible shared storage).
# Local driver stores files under UPLOAD_ROOT. For persistence across redeploys,
# point UPLOAD_ROOT at a mounted/persistent volume (do NOT use the container's
# ephemeral filesystem). Example: UPLOAD_ROOT=/var/lib/lms/uploads
# For cross-environment sync (live <-> local) and redeploy-safe storage,
# use STORAGE_DRIVER=s3 so all environments read/write the same bucket.
# UPLOAD_ROOT=server/uploads

# S3-compatible storage (only used when STORAGE_DRIVER=s3).
# Shared by every environment that uses the same bucket => real-time visibility.
# S3_BUCKET=your-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://s3.your-provider.com
# S3_PUBLIC_ENDPOINT=https://cdn.your-provider.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_KEY_PREFIX=lms-sop
# S3_FORCE_PATH_STYLE=true
# S3_ACL=public-read

# Hostinger Remote MySQL Notes:
# - Enable remote MySQL access in Hostinger phpMyAdmin
# - Whitelist your server IP in Hostinger MySQL settings
# - The DB_HOST should be the remote MySQL hostname from Hostinger
