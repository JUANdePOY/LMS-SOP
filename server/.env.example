PORT=5000
DB_HOST=your_hostinger_remote_mysql_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306
JWT_SECRET=change-this-in-production-use-a-long-random-string
CORS_ORIGINS=https://yourdomain.com,http://localhost:5173
NODE_ENV=production

# --- Google Calendar Integration (optional) ---
# Create OAuth 2.0 credentials (type: Web application) in Google Cloud Console
# and add the redirect URI: <APP_URL>/api/calendar/callback
# Scopes requested: https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://yourdomain.com/api/calendar/callback
# 32-byte key (hex) used to encrypt stored Google tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Public base URL of this app, used to build the OAuth consent link.
APP_URL=https://yourdomain.com
# Login rate limiting (applied only to POST /api/auth/login)
# LOGIN_RATE_LIMIT_WINDOW_MS defaults to 900000 (15 minutes)
# LOGIN_RATE_LIMIT_MAX defaults to 5
# Rate limiting is automatically skipped when NODE_ENV=development
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5

# --- File Storage ---
# STORAGE_DRIVER: "local" (default), "s3" (S3-compatible shared storage),
# or "mysql_blob" to store file bytes in the database. Use "mysql_blob" only
# for small shared files like avatars and thumbnails when local disk is not
# persistent across redeploys.
# Local driver stores files under UPLOAD_ROOT. For persistence across redeploys,
# point UPLOAD_ROOT at a mounted/persistent volume (do NOT use the container's
# ephemeral filesystem). Example: UPLOAD_ROOT=/var/lib/lms/uploads
# For cross-environment sync (live <-> local) and redeploy-safe storage,
# use STORAGE_DRIVER=s3 so all environments read/write the same bucket.
# UPLOAD_ROOT=server/uploads

# S3-compatible storage (only used when STORAGE_DRIVER=s3).
# Shared by every environment that uses the same bucket => real-time visibility.
# S3_BUCKET=your-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://s3.your-provider.com
# S3_PUBLIC_ENDPOINT=https://cdn.your-provider.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_KEY_PREFIX=lms-sop
# S3_FORCE_PATH_STYLE=true
# S3_ACL=public-read
# S3_PUBLIC=true

# Cloudflare R2 (S3-compatible) example:
# STORAGE_DRIVER=s3
# S3_BUCKET=your-r2-bucket
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account>.r2.dev
# S3_ACCESS_KEY_ID=your-r2-access-key
# S3_SECRET_ACCESS_KEY=your-r2-secret-key
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC=true
# Note: R2 does not support ACLs. Do NOT set S3_ACL for R2.

# Private bucket / R2 with Cloudflare Worker proxy:
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket
# S3_ENDPOINT=https://s3.your-provider.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC=false
# When S3_PUBLIC=false, stored URLs are relative (/uploads/s3/<key>) and served
# through the built-in /uploads/s3/:key(*) proxy route.

# Hostinger Remote MySQL Notes:
# - Enable remote MySQL access in Hostinger phpMyAdmin
# - Whitelist your server IP in Hostinger MySQL settings
# - The DB_HOST should be the remote MySQL hostname from Hostinger
