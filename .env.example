# LMS-SOP Environment Configuration
# Hostinger Deployment

# Server
PORT=5000
NODE_ENV=production

# Database (phpMyAdmin remote MySQL on Hostinger)
DB_HOST=your_hostinger_remote_mysql_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# Authentication
JWT_SECRET=change-this-in-production-use-a-long-random-string

# CORS (add your Hostinger domain after deployment)
CORS_ORIGINS=https://yourdomain.com,http://localhost:5173

# --- Google Calendar Integration (optional) ---
# See server/.env.example for details.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://yourdomain.com/api/calendar/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=
APP_URL=https://yourdomain.com
# File Storage (local disk for Hostinger)
UPLOAD_DIR=uploads

# Storage driver: "local" (default), "s3" (S3-compatible shared storage),
# or "mysql_blob" (persist uploads directly inside the MySQL database).
# Use mysql_blob when the host filesystem is not shared between deployments and
# you need uploaded assets like avatars/thumbnails to survive redeploys.
# STORAGE_DRIVER=local
# UPLOAD_ROOT=server/uploads
# S3_BUCKET=your-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://s3.your-provider.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# Email/SMTP (optional - Hostinger SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hostinger Remote MySQL Notes:
# - Enable remote MySQL access in Hostinger phpMyAdmin
# - Whitelist your server IP in Hostinger MySQL settings
# - The DB_HOST should be the remote MySQL hostname from Hostinger